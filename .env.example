# NextAuth
NEXTAUTH_URL="https://jouwapp.vercel.app"
NEXTAUTH_SECRET=""   # genereer met: openssl rand -base64 32

# Google OAuth (optioneel)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Apple OAuth (optioneel; nodig voor appstoreversies naast Google-login)
APPLE_CLIENT_ID=""        # Service ID, bv. com.pinacot.app.signin
APPLE_CLIENT_SECRET=""    # Apple client secret/JWT, door Sander zelf genereren en in Vercel zetten
NEXT_PUBLIC_ENABLE_APPLE_SIGN_IN="false"

# E-mailmeldingen voor ontbrekende/onjuist vermelde werken (Resend)
RESEND_API_KEY=""
FEEDBACK_FROM_EMAIL="Vernissage <meldingen@jouwdomein.nl>"
FEEDBACK_TO_EMAIL="s.regtuijt@gmail.com"

# Admin dashboard (komma-gescheiden lijst van toegestane account-e-mailadressen)
ADMIN_EMAILS="s.regtuijt@gmail.com"

# Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY=""
R2_SECRET_KEY=""
R2_BUCKET="arttracker-images"
R2_PUBLIC_URL="https://pub-xxx.r2.dev"
R2_PRIVATE_BUCKET="artfolio-bucket"   # separate bucket, NO public custom domain attached

# Stripe (testmodus eerst: sk_test_.../pk_test_...; live pas na sandboxproef)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""     # uit `stripe listen` (lokaal) of het dashboard (live)
STRIPE_PRICE_ID_PLUS_YEARLY="" # price-id van het jaarabonnement in het Stripe-dashboard
