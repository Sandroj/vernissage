generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Artist {
  id             Int       @id @default(autoincrement())
  name           String
  slug           String    @unique
  birth_year     Int?
  death_year     Int?
  nationality    String?
  nationality_en String?
  bio            String?
  bio_en         String?
  portrait_url   String?
  createdAt      DateTime  @default(now())
  artworks       Artwork[]
}

model Museum {
  id        Int       @id @default(autoincrement())
  name      String
  city      String
  country   String
  website   String?
  lat       Float?
  lng       Float?
  artworks  Artwork[]
  loansFrom Loan[]    @relation("LoanFrom")
  loansTo   Loan[]    @relation("LoanTo")
}

model Artwork {
  id                   Int              @id @default(autoincrement())
  artistId             Int
  museumId             Int?
  private_owner_name   String?
  title                String
  title_de             String?
  year_start           Int?
  year_end             Int?
  medium_raw           String?
  type_normalized      String?
  dimensions_raw       String?
  image_url            String?
  image_local_path     String?
  image_source_url     String?
  image_source_name    String?
  image_rights         String?
  image_retrieved_at   DateTime?
  source_url           String?
  source_name          String?
  catalogue_id         String?          @unique
  jh_catalogue_id      String?
  alternate_titles     String?
  location_confidence  String?
  location_verified_at DateTime?
  attribution_status   String?          @default("accepted")
  attribution_note     String?
  attribution_note_en  String?
  artist               Artist           @relation(fields: [artistId], references: [id])
  museum               Museum?          @relation(fields: [museumId], references: [id])
  seenBy               Seen[]
  visits               Visit[]
  reports              Report[]
  suggestions          WorkSuggestion[]
  loans                Loan[]
  edits                ArtworkEdit[]

  @@index([artistId])
  @@index([museumId])
  @@index([title])
  @@index([jh_catalogue_id])
}

model User {
  id                String       @id @default(cuid())
  name              String?
  email             String       @unique
  emailVerified     DateTime?
  image             String?
  password          String?
  passwordChangedAt DateTime?
  seenPublic        Boolean      @default(true)
  createdAt         DateTime     @default(now())
  accounts          Account[]
  sessions          Session[]
  seen              Seen[]
  visits            Visit[]
  votes             ArtistVote[]
  reports           Report[]
  billingCustomer   BillingCustomer?
  entitlement       Entitlement?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Seen {
  id           Int      @id @default(autoincrement())
  userId       String
  artworkId    Int
  dateSeen     DateTime
  locationSeen String?
  notes        String?
  rating       Int?
  photo_url    String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artwork      Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@unique([userId, artworkId])
  @@index([userId])
  @@index([artworkId])
}

model Visit {
  id           Int      @id @default(autoincrement())
  userId       String
  artworkId    Int
  dateSeen     DateTime
  locationSeen String?
  notes        String?
  rating       Int?
  photo_url    String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artwork      Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@index([userId, artworkId])
  @@index([artworkId])
}

model ArtistVote {
  id         Int      @id @default(autoincrement())
  userId     String
  artistName String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, artistName])
}

model Report {
  id        Int      @id @default(autoincrement())
  userId    String
  artworkId Int
  message   String
  status    String   @default("open")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artwork   Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@index([artworkId])
  @@index([userId])
}

model WorkSuggestion {
  id           Int       @id @default(autoincrement())
  kind         String
  artistName   String
  artworkId    Int?
  artworkTitle String?
  message      String
  senderEmail  String?
  status       String    @default("open")
  emailSentAt  DateTime?
  emailError   String?
  createdAt    DateTime  @default(now())
  artwork      Artwork?  @relation(fields: [artworkId], references: [id], onDelete: SetNull)

  @@index([artworkId])
  @@index([status])
}

model Loan {
  id            Int       @id @default(autoincrement())
  artworkId     Int
  fromMuseumId  Int?
  fromOwnerName String?
  toMuseumId    Int
  startAt       DateTime?
  endAt         DateTime?
  current       Boolean   @default(true)
  sourceUrl     String?
  verifiedAt    DateTime?
  note          String?
  createdAt     DateTime  @default(now())
  artwork       Artwork   @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  fromMuseum    Museum?   @relation("LoanFrom", fields: [fromMuseumId], references: [id], onDelete: SetNull)
  toMuseum      Museum    @relation("LoanTo", fields: [toMuseumId], references: [id], onDelete: Cascade)

  @@index([artworkId, current])
  @@index([fromMuseumId, current])
  @@index([toMuseumId, current])
}

model ArtworkEdit {
  id          Int      @id @default(autoincrement())
  artworkId   Int
  editorEmail String
  beforeJson  String
  afterJson   String
  sourceUrl   String?
  createdAt   DateTime @default(now())
  artwork     Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@index([artworkId, createdAt])
}

// Stripe-koppeling. Betaling (Subscription/BillingEvent) blijft gescheiden
// van het recht op een feature (Entitlement) — zie plan §7. Eén webhook kan
// dus Entitlement bijwerken zonder dat Subscription-historie verloren gaat.
model BillingCustomer {
  id               String         @id @default(cuid())
  userId           String         @unique
  stripeCustomerId String         @unique
  createdAt        DateTime       @default(now())
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions    Subscription[]
}

model Subscription {
  id                   String          @id @default(cuid())
  billingCustomerId    String
  stripeSubscriptionId String          @unique
  stripePriceId        String
  status               String
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean         @default(false)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  billingCustomer      BillingCustomer @relation(fields: [billingCustomerId], references: [id], onDelete: Cascade)

  @@index([billingCustomerId])
  @@index([status])
}

// Ruwe webhook-log, sleutel op Stripe's event-id: voorkomt dubbele verwerking
// bij herhaalde/uit-volgorde afgeleverde webhooks (plan §7) en dient als
// reconciliatiebron.
model BillingEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  type          String
  payload       String
  processedAt   DateTime @default(now())

  @@index([type])
}

model Entitlement {
  id        String    @id @default(cuid())
  userId    String    @unique
  plan      String
  active    Boolean   @default(false)
  expiresAt DateTime?
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
