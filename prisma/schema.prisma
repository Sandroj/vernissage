generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Artist {
  id           Int       @id @default(autoincrement())
  name         String
  slug         String    @unique
  birth_year   Int?
  death_year   Int?
  nationality  String?
  nationality_en String?
  bio          String?
  bio_en       String?
  portrait_url String?
  createdAt    DateTime  @default(now())
  artworks     Artwork[]
}

model Museum {
  id       Int       @id @default(autoincrement())
  name     String
  city     String
  country  String
  website  String?
  lat      Float?
  lng      Float?
  artworks Artwork[]
}

model Artwork {
  id               Int      @id @default(autoincrement())
  artistId         Int
  museumId         Int?
  title            String
  year_start       Int?
  year_end         Int?
  medium_raw       String?
  type_normalized  String?
  dimensions_raw   String?
  image_url        String?
  image_local_path String?
  image_source_url String?
  image_source_name String?
  image_rights     String?
  image_retrieved_at DateTime?
  source_url       String?
  source_name      String?
  catalogue_id     String?   @unique
  jh_catalogue_id  String?
  alternate_titles String?
  location_confidence String?
  location_verified_at DateTime?
  attribution_status String?  @default("accepted")
  attribution_note String?
  artist           Artist   @relation(fields: [artistId], references: [id])
  museum           Museum?  @relation(fields: [museumId], references: [id])
  seenBy           Seen[]
  reports          Report[]

  @@index([artistId])
  @@index([museumId])
  @@index([title])
  @@index([jh_catalogue_id])
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  password      String?
  seenPublic    Boolean      @default(true)
  createdAt     DateTime     @default(now())
  accounts      Account[]
  sessions      Session[]
  seen          Seen[]
  votes         ArtistVote[]
  reports       Report[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Seen {
  id           Int      @id @default(autoincrement())
  userId       String
  artworkId    Int
  dateSeen     DateTime
  locationSeen String?
  notes        String?
  rating       Int?
  photo_url    String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artwork      Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([artworkId])
  @@unique([userId, artworkId])
}

model ArtistVote {
  id         Int      @id @default(autoincrement())
  userId     String
  artistName String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, artistName])
}

model Report {
  id        Int      @id @default(autoincrement())
  userId    String
  artworkId Int
  message   String
  status    String   @default("open")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artwork   Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@index([artworkId])
  @@index([userId])
}
